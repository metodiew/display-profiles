#!/bin/bash

# Enable debug output
exec 2>/tmp/display-profiles-debug.log
set -x

# Log environment information
echo "Current user: $(whoami)" >> /tmp/display-profiles-debug.log
echo "DISPLAY: $DISPLAY" >> /tmp/display-profiles-debug.log
echo "XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR" >> /tmp/display-profiles-debug.log
echo "DBUS_SESSION_BUS_ADDRESS: $DBUS_SESSION_BUS_ADDRESS" >> /tmp/display-profiles-debug.log

# Ensure we have a display
if [ -z "$DISPLAY" ]; then
    export DISPLAY=:0
fi

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Check if zenity is available
if ! command -v zenity >/dev/null 2>&1; then
    echo "Error: zenity is not installed. Please install it with: sudo apt install zenity" >> /tmp/display-profiles-debug.log
    exit 1
fi

# Try to ensure we have access to the X server
xhost >/dev/null 2>&1

# Read profiles dynamically from config file
CONFIG_FILE="$HOME/.local/bin/display-profiles.conf"
if [ ! -f "$CONFIG_FILE" ]; then
    CONFIG_FILE="$SCRIPT_DIR/display-profiles.conf"
fi

# Outputs that are connected right now
mapfile -t CONNECTED < <(xrandr --query | awk '/ connected/ {print $1}')

is_connected() {
    local out
    for out in "${CONNECTED[@]}"; do
        [ "$out" = "$1" ] && return 0
    done
    return 1
}

# Each profile gets a status: "ready" when every display it turns on is connected,
# otherwise the missing outputs. Ready profiles are listed first.
READY_ROWS=()
MISSING_ROWS=()
while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*# ]] && continue
    [[ -z "$line" ]] && continue
    IFS='|' read -ra parts <<< "$line"
    missing=()
    for i in "${!parts[@]}"; do
        [ "$i" -eq 0 ] && continue
        IFS=',' read -r name mode _ <<< "${parts[$i]}"
        [ "$mode" = "off" ] && continue
        is_connected "$name" || missing+=("$name")
    done
    if [ ${#missing[@]} -eq 0 ]; then
        READY_ROWS+=("${parts[0]}" "ready")
    else
        MISSING_ROWS+=("${parts[0]}" "needs ${missing[*]}")
    fi
done < "$CONFIG_FILE"

if [ $(( ${#READY_ROWS[@]} + ${#MISSING_ROWS[@]} )) -eq 0 ]; then
    zenity --error --title="Error" --text="No profiles found in configuration." --width=300
    exit 1
fi

PROFILE=$(zenity --list \
    --title="Display Profiles Switcher" \
    --text="Select a display profile (connected: ${CONNECTED[*]}):" \
    --column="Profile" \
    --column="Monitors" \
    --print-column=1 \
    --width=420 \
    --height=460 \
    "${READY_ROWS[@]}" \
    "${MISSING_ROWS[@]}" \
)

# Log the result
echo "Selected profile: $PROFILE" >> /tmp/display-profiles-debug.log

# Exit if no selection was made
if [ -z "$PROFILE" ]; then
    echo "No profile selected" >> /tmp/display-profiles-debug.log
    exit 0
fi

# Apply the selected profile using absolute path
if "$SCRIPT_DIR/display-profiles" "$PROFILE" >/tmp/display-profile-error.log 2>&1; then
    echo "Profile applied successfully" >> /tmp/display-profiles-debug.log
    exit 0
else
    ERROR_MSG=$(cat /tmp/display-profile-error.log)
    echo "Error applying profile: $ERROR_MSG" >> /tmp/display-profiles-debug.log
    zenity --error \
        --title="Error" \
        --text="Failed to apply profile '$PROFILE'.\n\nError details:\n$ERROR_MSG" \
        --width=400
    rm -f /tmp/display-profile-error.log
fi
